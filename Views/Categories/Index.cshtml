@model List<CourseCategory>
@{ViewData["Title"]="Danh mục";}
<div class="pagehead"><div><div class="eyebrow">QUẢN LÝ PHÂN LOẠI</div><h1>Danh mục khóa học</h1><p>Quản lý các nhóm khóa học và số lượng khóa học liên quan.</p></div><a asp-action="Create" class="btn btn-primary">+ Thêm danh mục</a></div><div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Tên danh mục</th><th>Mô tả</th><th>Số khóa học</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>#@c.Id</td><td><strong>@c.Name</strong></td><td>@c.Description</td><td><span class="pill neutral">@c.Courses.Count khóa học</span></td><td><div class="actions"><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục?')"><button class="link-danger">Xóa</button></form></div></td></tr>}</tbody></table></div></div>