@model CourseCategory
@{bool edit=Model.Id>0;ViewData["Title"]=edit?"Sửa danh mục":"Thêm danh mục";}
<div class="pagehead"><div><div class="eyebrow">DANH MỤC KHÓA HỌC</div><h1>@(edit?"Sửa danh mục":"Thêm danh mục")</h1></div><a class="btn btn-outline-secondary" asp-action="Index">← Quay lại</a></div><div class="panel form-panel"><form asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.Id:(int?)null)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label">Tên danh mục *</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><button class="btn btn-primary">Lưu danh mục</button></form></div>