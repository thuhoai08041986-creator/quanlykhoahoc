<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · EduManage</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><div class="shell"><aside class="sidebar"><div class="brand">✦ Edu<span>Manage</span></div><div class="side-caption">QUẢN TRỊ HỆ THỐNG</div><a asp-controller="Home" asp-action="Index" class="navitem">◫ &nbsp; Tổng quan</a><a asp-controller="Courses" asp-action="Index" class="navitem">▤ &nbsp; Khóa học</a><a asp-controller="Categories" asp-action="Index" class="navitem">▦ &nbsp; Danh mục</a><div class="sidebar-bottom">Course Management<br/><small>ASP.NET Core MVC · SQL Server</small></div></aside><div class="workspace"><header class="topbar"><div>Hệ thống quản lý đào tạo</div><div class="avatar">AD</div></header><main class="content">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</main></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>