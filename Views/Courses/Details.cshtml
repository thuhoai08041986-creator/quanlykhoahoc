@model Course
@{ViewData["Title"]="Chi tiết khóa học";}
<div class="pagehead"><div><div class="eyebrow">CHI TIẾT KHÓA HỌC</div><h1>@Model.Name</h1><p>@Model.CourseCategory?.Name · @Model.Duration giờ · @Model.DurationType</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">← Danh sách</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa khóa học</a></div></div>
<div class="panel"><div class="row g-3"><div class="col-md-3"><div class="detail-label">Học phí</div><h3 class="money">@Model.TuitionFee.ToString("N0") ₫</h3></div><div class="col-md-3"><div class="detail-label">Trạng thái</div><span class="pill @(Model.IsActive?"on":"off")">@(Model.IsActive?"Đang tuyển sinh":"Ngừng tuyển sinh")</span></div><div class="col-md-6"><div class="detail-label">Mô tả</div><p>@(Model.Description??"Chưa có mô tả")</p></div></div></div>
@{var featured=Model.CourseImages.FirstOrDefault(x=>x.IsThumbnail)??Model.CourseImages.FirstOrDefault();}
@if(featured!=null){<div class="panel"><div class="detail-label mb-2">Ảnh khóa học</div><img class="course-hero" src="@featured.ImageUrl" alt="Ảnh đại diện @Model.Name"/></div>}
<div class="panel"><div class="panel-title"><h3>Thư viện hình ảnh (@Model.CourseImages.Count)</h3></div><form asp-action="AddImage" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end mb-4"><div class="col-md-7"><label class="form-label">Đường dẫn URL ảnh</label><input name="imageUrl" type="url" required maxlength="1000" placeholder="https://example.com/image.jpg" class="form-control"/></div><div class="col-md-3"><label class="form-label d-block">Tùy chọn</label><label class="form-check"><input class="form-check-input" name="isThumbnail" value="true" type="checkbox"/> Đặt làm ảnh đại diện</label></div><div class="col-md-2"><button class="btn btn-primary w-100">+ Thêm ảnh</button></div></form><form asp-action="UploadImage" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mb-4"><div class="col-md-7"><label class="form-label">Hoặc tải nhiều ảnh từ máy tính (mỗi ảnh tối đa 5MB)</label><input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple required class="form-control"/></div><div class="col-md-3"><label class="form-check"><input type="checkbox" name="isThumbnail" value="true" class="form-check-input"/> Đặt làm ảnh đại diện</label></div><div class="col-md-2"><button class="btn btn-primary w-100">Tải ảnh lên</button></div></form><div class="image-grid">@foreach(var img in Model.CourseImages.OrderByDescending(x=>x.IsThumbnail).ThenBy(x=>x.Id)){<div class="image-card"><img src="@img.ImageUrl" alt="Ảnh khóa học" onerror="this.style.opacity='.15'"/><div class="image-meta"><span class="pill @(img.IsThumbnail?"on":"neutral")">@(img.IsThumbnail?"Ảnh đại diện":"Ảnh thường")</span><div class="actions">@if(!img.IsThumbnail){<form asp-action="SetThumbnail" asp-route-id="@img.Id" method="post"><input type="hidden" name="courseId" value="@Model.Id"/><button>Chọn đại diện</button></form>}<form asp-action="DeleteImage" asp-route-id="@img.Id" method="post" onsubmit="return confirm('Xóa ảnh này?')"><input type="hidden" name="courseId" value="@Model.Id"/><button class="link-danger">Xóa</button></form></div></div></div>}</div>@if(!Model.CourseImages.Any()){<div class="empty">Khóa học chưa có ảnh. Hãy chọn ảnh từ máy hoặc thêm URL ở trên.</div>}</div>