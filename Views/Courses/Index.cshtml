@model List<Course>
@{ViewData["Title"]="Khóa học";var f=(CourseSearch)ViewBag.Filter;}
<div class="pagehead"><div><div class="eyebrow">QUẢN LÝ ĐÀO TẠO</div><h1>Danh sách khóa học</h1><p>Tìm kiếm, lọc và cập nhật thông tin khóa học.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm khóa học</a></div>
<div class="panel filter-panel"><form method="get" asp-action="Index"><div class="row g-3"><div class="col-md-4"><label class="form-label">Tên khóa học</label><input class="form-control" name="Keyword" value="@f.Keyword" placeholder="Nhập tên khóa học..."/></div><div class="col-md-4"><label class="form-label">Danh mục</label><select class="form-select" name="CategoryId"><option value="">Tất cả danh mục</option>@foreach(var cat in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Categories){<option value="@cat.Value" selected="@(f.CategoryId?.ToString()==cat.Value)">@cat.Text</option>}</select></div><div class="col-md-4"><label class="form-label">Trạng thái</label><select class="form-select" name="IsActive"><option value="">Tất cả trạng thái</option><option value="true" selected="@(f.IsActive==true)">Đang tuyển sinh</option><option value="false" selected="@(f.IsActive==false)">Ngừng tuyển sinh</option></select></div><div class="col-md-3"><label class="form-label">Học phí tối thiểu</label><input type="number" step="0.01" min="0" class="form-control" name="MinFee" value="@f.MinFee"/></div><div class="col-md-3"><label class="form-label">Học phí tối đa</label><input type="number" step="0.01" min="0" class="form-control" name="MaxFee" value="@f.MaxFee"/></div><div class="col-md-3"><label class="form-label">Sắp xếp</label><select class="form-select" name="SortBy"><option value="">Mới nhất</option><option value="fee_asc" selected="@(f.SortBy=="fee_asc")">Học phí tăng dần</option><option value="fee_desc" selected="@(f.SortBy=="fee_desc")">Học phí giảm dần</option><option value="duration_asc" selected="@(f.SortBy=="duration_asc")">Thời lượng tăng dần</option></select></div><div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-primary flex-grow-1">Lọc dữ liệu</button><a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div></div></form></div>
@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}
<div class="panel"><div class="panel-title"><h3>Khóa học <small class="text-muted">(@Model.Count kết quả)</small></h3></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Ảnh</th><th>Khóa học</th><th>Danh mục</th><th>Học phí</th><th>Thời lượng</th><th>Phân loại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td class="text-muted">#@c.Id</td><td>@{var cover=c.CourseImages.FirstOrDefault(x=>x.IsThumbnail)??c.CourseImages.FirstOrDefault();} @if(cover!=null){<a asp-action="Details" asp-route-id="@c.Id"><img src="@cover.ImageUrl" alt="@c.Name" class="course-thumb" loading="lazy"/></a>}else{<div class="course-thumb course-thumb-empty">Chưa có ảnh</div>}</td><td><strong>@c.Name</strong></td><td>@c.CourseCategory?.Name</td><td class="money">@c.TuitionFee.ToString("N0") ₫</td><td>@c.Duration giờ</td><td><span class="pill neutral">@c.DurationType</span></td><td><span class="pill @(c.IsActive?"on":"off")">@(c.IsActive?"Đang tuyển sinh":"Ngừng tuyển sinh")</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@c.Id">Chi tiết</a><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Xóa khóa học này?')"><button class="link-danger">Xóa</button></form></div></td></tr>}@if(Model.Count==0){<tr><td colspan="9" class="empty">Không tìm thấy khóa học phù hợp.</td></tr>}</tbody></table></div></div>