@model Course
@{bool edit=Model.Id>0;ViewData["Title"]=edit?"Sửa khóa học":"Thêm khóa học";}
<div class="pagehead"><div><div class="eyebrow">QUẢN LÝ KHÓA HỌC</div><h1>@(edit?"Cập nhật khóa học":"Thêm khóa học mới")</h1><p>Điền đầy đủ thông tin và nhấn lưu.</p></div><a class="btn btn-outline-secondary" asp-action="Index">← Quay lại</a></div>
<div class="panel form-panel"><form asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.Id:(int?)null)" method="post" enctype="multipart/form-data"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label">Tên khóa học *</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="CourseCategoryId" class="form-label">Loại khóa học *</label><select asp-for="CourseCategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="0">-- Chọn danh mục --</option></select><span asp-validation-for="CourseCategoryId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="TuitionFee" class="form-label">Học phí (VNĐ) *</label><input asp-for="TuitionFee" type="number" step="0.01" min="0.01" class="form-control"/><span asp-validation-for="TuitionFee" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Duration" class="form-label">Thời lượng (giờ) *</label><input asp-for="Duration" type="number" min="1" class="form-control"/><span asp-validation-for="Duration" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label">Mô tả</label><textarea asp-for="Description" rows="5" class="form-control"></textarea></div><div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Đang tuyển sinh</label></div></div></div><div class="mt-3"><label for="photo" class="form-label">Ảnh khóa học (JPG, PNG, WEBP, GIF; tối đa 5MB)</label><input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control"/><small class="text-muted">Có thể bỏ trống; thêm nhiều ảnh ở trang Chi tiết.</small></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Lưu khóa học</button><a class="btn btn-outline-secondary" asp-action="Index">Hủy</a></div></form></div>