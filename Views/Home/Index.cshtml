@model List<Course>
@{ViewData["Title"]="Tổng quan";}
<div class="pagehead"><div><div class="eyebrow">BẢNG ĐIỀU KHIỂN</div><h1>Tổng quan đào tạo</h1><p>Quản lý và theo dõi toàn bộ khóa học trong hệ thống.</p></div><a class="btn btn-primary" asp-controller="Courses" asp-action="Create">+ Thêm khóa học</a></div>
<div class="stat-grid"><div class="stat"><span>Tổng khóa học</span><strong>@ViewBag.Courses</strong><small>Toàn bộ khóa học</small></div><div class="stat"><span>Danh mục</span><strong>@ViewBag.Categories</strong><small>Nhóm đào tạo</small></div><div class="stat"><span>Đang tuyển sinh</span><strong>@ViewBag.Active</strong><small>Đang hoạt động</small></div><div class="stat"><span>Ngừng tuyển sinh</span><strong>@ViewBag.Inactive</strong><small>Tạm ngừng</small></div></div>
<div class="panel"><div class="panel-title"><h3>Khóa học mới nhất</h3><a asp-controller="Courses" asp-action="Index">Xem tất cả →</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Khóa học</th><th>Danh mục</th><th>Học phí</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td><td>@c.CourseCategory?.Name</td><td>@c.TuitionFee.ToString("N0") ₫</td><td><span class="pill @(c.IsActive?"on":"off")">@(c.IsActive?"Đang tuyển sinh":"Ngừng tuyển sinh")</span></td></tr>}</tbody></table></div></div>